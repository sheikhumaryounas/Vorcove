# Copy this file to .env and fill in the values.

# MongoDB connection string (MongoDB Atlas or a local MongoDB).
# Leave it empty in development to use a temporary in-memory database.
MONGODB_URI=

# Port the API listens on.
PORT=5000

# Secret token for reading leads: GET /api/leads with header "Authorization: Bearer <token>".
# Leave empty to switch the leads list off.
ADMIN_TOKEN=
